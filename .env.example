# A to Zero — local settings. Copy this file to ".env" and edit as you like.
#   cp .env.example .env      (macOS/Linux)
#   copy .env.example .env    (Windows PowerShell)
# Your .env is git-ignored, so `git pull` will never overwrite these.

# The port you open in your browser (http://localhost:<A2Z_PORT>).
# Pick anything free on your machine.
A2Z_PORT=8888

# The real store to mirror. Swap and rebuild to shop a different site, e.g.
#   https://www.walmart.com  |  https://www.target.com  |  https://www.newegg.com
TARGET=https://www.amazon.com
